package com.soulsync.service;
import com.soulsync.domain.*; import com.soulsync.domain.Enums.PhotoVisibility; import com.soulsync.exception.*; import com.soulsync.repository.ProfilePhotoRepository; import com.soulsync.security.CurrentUser; import com.soulsync.web.dto.ProfileDtos.PhotoDto;
import lombok.RequiredArgsConstructor; import org.springframework.beans.factory.annotation.Value; import org.springframework.core.io.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.web.multipart.MultipartFile;
import java.io.*; import java.nio.file.*; import java.util.*;
@Service @RequiredArgsConstructor
public class PhotoService { private final ProfilePhotoRepository photos; private final CurrentUser current; private final ConnectionService connections; @Value("${soulsync.uploads-dir}") String uploadsDir;
 public record PhotoContent(Resource resource,String contentType){}
 @Transactional public PhotoDto upload(MultipartFile file,PhotoVisibility visibility)throws IOException{ if(file.isEmpty())throw new BadRequestException("Choose an image"); if(file.getSize()>10*1024*1024L)throw new BadRequestException("Photo must be under 10MB"); String ct=Optional.ofNullable(file.getContentType()).orElse(""); String ext=switch(ct){case "image/jpeg"->"jpg";case "image/png"->"png";case "image/webp"->"webp";default->throw new BadRequestException("Only JPEG, PNG and WebP images are allowed");}; byte[] data=file.getBytes(); if(!signatureMatches(data,ext))throw new BadRequestException("File contents do not match the declared image type"); var dir=Path.of(uploadsDir).toAbsolutePath().normalize();Files.createDirectories(dir);UUID id=UUID.randomUUID();String key=UUID.randomUUID()+"."+ext;Path target=dir.resolve(key).normalize();if(!target.startsWith(dir))throw new BadRequestException("Invalid file path");Files.write(target,data,StandardOpenOption.CREATE,StandardOpenOption.TRUNCATE_EXISTING); var existing=photos.findByUserIdOrderBySortOrderAsc(current.id()); var p=photos.save(ProfilePhoto.builder().id(id).user(current.entity()).storageKey(key).url("/api/v1/photos/"+id+"/content").sortOrder(existing.size()).primary(existing.isEmpty()).visibility(visibility==null?PhotoVisibility.PUBLIC:visibility).build()); return dto(p); }
 @Transactional(readOnly=true) public PhotoContent content(UUID id){var p=photos.findById(id).orElseThrow(()->new NotFoundException("Photo not found"));UUID me=current.id();boolean allowed=p.getUser().getId().equals(me)||p.getVisibility()==PhotoVisibility.PUBLIC||(p.getVisibility()==PhotoVisibility.CONNECTIONS&&connections.connected(me,p.getUser().getId()));if(!allowed)throw new ForbiddenException("Photo is private");Path file=Path.of(uploadsDir).toAbsolutePath().normalize().resolve(p.getStorageKey()).normalize();if(!file.startsWith(Path.of(uploadsDir).toAbsolutePath().normalize())||!Files.exists(file))throw new NotFoundException("Photo file not found");String ct=p.getStorageKey().endsWith(".png")?"image/png":p.getStorageKey().endsWith(".webp")?"image/webp":"image/jpeg";return new PhotoContent(new FileSystemResource(file),ct);}
 @Transactional public void delete(UUID id)throws IOException{ var p=photos.findByIdAndUserId(id,current.id()).orElseThrow(()->new NotFoundException("Photo not found")); photos.delete(p);Files.deleteIfExists(Path.of(uploadsDir).toAbsolutePath().normalize().resolve(p.getStorageKey())); if(p.isPrimary()){photos.findByUserIdOrderBySortOrderAsc(current.id()).stream().findFirst().ifPresent(x->{x.setPrimary(true);photos.save(x);});} }
 @Transactional public List<PhotoDto> setPrimary(UUID id){ var mine=photos.findByUserIdOrderBySortOrderAsc(current.id()); if(mine.stream().noneMatch(p->p.getId().equals(id)))throw new NotFoundException("Photo not found"); mine.forEach(p->p.setPrimary(p.getId().equals(id))); photos.saveAll(mine); return mine.stream().map(this::dto).toList(); }
 @Transactional public PhotoDto visibility(UUID id,PhotoVisibility v){var p=photos.findByIdAndUserId(id,current.id()).orElseThrow(()->new NotFoundException("Photo not found"));p.setVisibility(v);return dto(p);}
 @Transactional(readOnly=true) public List<PhotoDto> mine(){return photos.findByUserIdOrderBySortOrderAsc(current.id()).stream().map(this::dto).toList();}
 private static boolean signatureMatches(byte[] b,String ext){ if(ext.equals("jpg"))return b.length>=3&&(b[0]&0xff)==0xff&&(b[1]&0xff)==0xd8&&(b[2]&0xff)==0xff; if(ext.equals("png"))return b.length>=8&&(b[0]&0xff)==0x89&&b[1]==0x50&&b[2]==0x4e&&b[3]==0x47&&b[4]==0x0d&&b[5]==0x0a&&b[6]==0x1a&&b[7]==0x0a; return b.length>=12&&b[0]=='R'&&b[1]=='I'&&b[2]=='F'&&b[3]=='F'&&b[8]=='W'&&b[9]=='E'&&b[10]=='B'&&b[11]=='P'; }
 private PhotoDto dto(ProfilePhoto p){return new PhotoDto(p.getId(),p.getUrl(),p.getSortOrder(),p.isPrimary(),p.getVisibility());}
}
