# Database
DATABASE_PASSWORD=soulsync_dev

# MUST be a long random secret in production (32+ bytes)
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-bytes

# Local development helpers. Set both false in production.
DEV_MODE=true
SEED_DEMO=true

# OTP policy
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Local email: set true to deliver OTP/reset mail into Mailpit at http://localhost:8025
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@soulsync.local

# SMS. "dev" sends nothing and exposes the code only while DEV_MODE=true.
# Use "twilio" plus the three credentials below for real SMS.
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe (optional locally; required for real paid checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_PLUS=

# Photo storage
# Use "local" while developing.
# Use "cloudinary" in production.
PHOTO_STORAGE_PROVIDER=cloudinary

